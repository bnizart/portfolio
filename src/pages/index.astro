---
import Base from '@/layouts/Base.astro';
import WorkExperience from '@/components/WorkExperience.astro';
import Education from '@/components/Education.astro';
import Volunteering from '@/components/Volunteering.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Books from '@/components/Books.astro';
import Contact from '@/components/Contact.astro';

import { Image } from 'astro:assets';
import avatar from '@/assets/avatar.webp';
---

<Base title="Bastien Nizart" description="Développeur web basé en France">

  <!-- Hero -->
  <header class="flex items-start justify-between gap-8">
    <div>
      <h1 class="text-5xl font-bold tracking-tight text-zinc-900">
        Hi, I'm Bastien 👋🏻
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-zinc-500 max-w-sm">
        Auto Entrepreneur | Ingénieur Logiciel
      </p>
    </div>

    <Image
      src={avatar}
      alt="Bastien Nizart"
      width={112}
      height={112}
      class="size-28 rounded-full shrink-0 mt-1 object-cover ring-2 ring-zinc-200"
      loading="eager"
      fetchpriority="high"
    />
  </header>

  <!-- About -->
  <section class="mt-5">
    <h2 class="text-base font-semibold text-zinc-900 uppercase tracking-wider">
      About
    </h2>
    <p class="mt-4 text-base text-zinc-500 leading-relaxed">
      Ingénieur logiciel basé dans les Hauts-de-France, je travaille en CDI et en indépendant.
      Ma philosophie tient en trois mots : <em class="text-zinc-700 not-italic font-medium">Built for Life</em>.
      Architectures sans superflu, code maintenable, systèmes pensés pour durer ;
      j'applique la même exigence quelle que soit l'échelle du projet.
    </p>
    <p class="mt-4 text-base text-zinc-500 leading-relaxed">
      En dehors du code, je voyage en onebag ; même philosophie : fonctionnel, léger, durable.
      Je passe une bonne partie de mon temps libre à randonner et bivouaquer,
      avec une attirance marquée pour les paysages nordiques et bruts.
      Athlète hybride, j'allie musculation et cardio ; cette rigueur déborde naturellement sur mon travail.
    </p>
  </section>

  <WorkExperience />
  <Education />
  <Volunteering />
  <Skills />
  <Projects />
  <Books />
  <Contact />

</Base>
