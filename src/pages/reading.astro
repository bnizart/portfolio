---
import Base from '@/layouts/Base.astro';
import BookCard from '@/components/BookCard.astro';
import { books } from '@/data/books';

const byYear = books.reduce<Record<number, typeof books>>((acc, book) => {
  (acc[book.readYear] ??= []).push(book);
  return acc;
}, {});

for (const year of Object.keys(byYear)) {
  byYear[Number(year)].sort((a, b) => b.readOrder - a.readOrder);
}

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<Base title="Lectures — Bastien Nizart" description="Tous les livres lus par Bastien Nizart">

  <header class="mb-10">
    <a href="/" class="text-sm text-zinc-400 hover:text-zinc-700 transition-colors duration-150">
      ← Retour
    </a>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-900">
      Lectures
    </h1>
    <p class="mt-2 text-base text-zinc-500">
      {books.length} livre{books.length > 1 ? 's' : ''} lus
    </p>
  </header>

  {years.map((year) => (
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider shrink-0">
          {year}
        </h2>
        <div class="h-px flex-1 bg-zinc-200"></div>
      </div>

      <div class="grid grid-cols-3 gap-x-4 gap-y-6 sm:grid-cols-4">
        {byYear[year].map((book) => <BookCard book={book} />)}
      </div>
    </section>
  ))}

</Base>
