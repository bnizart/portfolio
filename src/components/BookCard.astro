---
import { Image } from 'astro:assets';
import type { Book } from '@/data/books';

interface Props {
  book: Book;
}
const { book } = Astro.props;
---

<div class="flex flex-col gap-2">
  <div class="w-full rounded-lg overflow-hidden shadow-md" style="aspect-ratio: 2/3;">
    <Image
      src={book.cover}
      alt={book.title}
      width={200}
      height={300}
      class="w-full h-full object-cover"
    />
  </div>
  <div class="min-w-0">
    <p class="text-sm font-medium text-zinc-900 leading-snug line-clamp-2">
      {book.title}
    </p>
    <p class="mt-0.5 text-xs text-zinc-400 truncate">
      {book.author}
    </p>
  </div>
</div>
