---
const navItems = [
  { href: '/',         label: 'Accueil',  icon: 'home'  },
  { href: '/articles', label: 'Blog',     icon: 'blog'  },
  { href: '/reading',  label: 'Lectures', icon: 'book'  },
] as const;

const socialItems = [
  { href: 'https://github.com/bnizart',              label: 'GitHub',   icon: 'github',   external: true  },
  { href: 'https://linkedin.com/in/bastien-nizart', label: 'LinkedIn', icon: 'linkedin', external: true  },
  { href: 'mailto:bastien@nizart.me',               label: 'Email',    icon: 'mail',     external: false },
  { href: 'https://webdav.nizart.me/documents/cv-bastien-nizart.pdf', label: 'CV', icon: 'file', external: true },
] as const;
---

<nav
  class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50"
  aria-label="Navigation principale"
>
  <div class="flex items-center gap-0.5 px-2.5 py-2
    bg-white
    backdrop-blur-xl
    border border-zinc-200
    rounded-2xl
    shadow-[0_8px_32px_rgba(0,0,0,0.14),0_2px_8px_rgba(0,0,0,0.08)]
   
    ring-1 ring-inset ring-white">

    <!-- Navigation -->
    {navItems.map(({ href, label, icon }) => (
      icon === 'blog' ? (
        <span class="dock-btn cursor-default opacity-50" data-tooltip={label} aria-label={label}>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
          </svg>
        </span>
      ) : (
        <a href={href} class="dock-btn" data-tooltip={label} aria-label={label}>
          {icon === 'home' && (
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          )}
          {icon === 'book' && (
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
          )}
        </a>
      )
    ))}

    <!-- Séparateur -->
    <div class="w-px h-5 bg-zinc-300 mx-1.5" role="separator" aria-hidden="true"></div>

    <!-- Réseaux sociaux -->
    {socialItems.map(({ href, label, icon, external }) => (
      <a
        href={href}
        class="dock-btn"
        data-tooltip={label}
        aria-label={label}
        {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {icon === 'github' && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5">
            <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
          </svg>
        )}
        {icon === 'linkedin' && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-5">
            <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
        )}
        {icon === 'mail' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
        )}
        {icon === 'file' && (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        )}
      </a>
    ))}

    <!-- Langue -->
    <button
      class="dock-btn text-base leading-none"
      data-tooltip="Français"
      aria-label="Langue : Français"
      type="button"
      disabled
    >
      🇫🇷
    </button>
  </div>
</nav>

<style>
  @reference "tailwindcss";

  .dock-btn {
    @apply relative flex items-center justify-center w-9 h-9 rounded-xl cursor-pointer
      text-zinc-400
      hover:text-zinc-900
      hover:bg-zinc-100
      transition-colors duration-150
      outline-none focus-visible:ring-2 focus-visible:ring-zinc-400
  }

  /* Tooltip */
  .dock-btn::before {
    content: attr(data-tooltip);
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 4px 8px;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    border-radius: 6px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms ease, transform 120ms ease;
    @apply bg-zinc-900 text-zinc-50
  }

  .dock-btn:hover::before,
  .dock-btn:focus-visible::before {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Pas de tooltip sur le bouton désactivé */
  button:disabled.dock-btn {
    @apply cursor-default opacity-70;
  }
  button:disabled.dock-btn::before {
    display: none;
  }
</style>
